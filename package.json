{
  "name": "heartos",
  "private": true,
  "version": "1.0.0",
  "description": "HeartOS: quản gia số cho gia đình gồm Nhịp Nhà, GenAI, Guardian, SmartHome và ARGOLET Sentinel.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty && tsc -p desktop/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:prepare": "npm run build && node desktop/build.mjs",
    "desktop:dev": "node desktop/build.mjs && electron desktop/app",
    "desktop:dist": "npm run desktop:prepare && cd desktop && electron-builder --config electron-builder.json",
    "hub": "node desktop/build.mjs && node desktop/release/heartos-hub.cjs --pair",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "immer": "^11.2.10",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "openai": "^7.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "resedit": "^3.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
